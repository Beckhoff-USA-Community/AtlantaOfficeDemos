	<ModuleTmcs>
		<ModuleTmc GUID="{5FC17892-62EA-4736-9999-D79964E87717}" TcSmClass="TComMcPlanarMoverObj">
			<Name>Planar Mover</Name>
			<CLSID ClassFactory="TcNc3">{050300C6-0000-0000-F000-000000000064}</CLSID>
			<Info>
				<ImageData></ImageData>
				<TabExtension Url="motion\planarmotion\views\moverui.html">
					<Url>Motion UI</Url><![CDATA[Motion UI]]></TabExtension>
			</Info>
			<Licenses>
				<License>
					<LicenseId>{C2F58FAE-EB3E-4252-A3D4-E912569E6EFC}</LicenseId>
				</License>
			</Licenses>
			<Parameters>
				<Group><![CDATA[General]]></Group>
				<Group Collapsed="true"><![CDATA[Simulation]]></Group>
				<Group Collapsed="true"><![CDATA[Hardware]]></Group>
				<Group><![CDATA[Maximum Dynamics]]></Group>
				<Group><![CDATA[Default Dynamics]]></Group>
				<Group Collapsed="true"><![CDATA[Monitoring]]></Group>
				<Group><![CDATA[Command mode on track]]></Group>
				<Group Collapsed="true"><![CDATA[Internal]]></Group>
				<Parameter HideParameter="true">
					<Name>TraceLevel</Name>
					<BitSize>32</BitSize>
					<BaseType GUID="{8007AE3B-86BB-40F2-B385-EF87FCC239A4}">TcTraceLevel</BaseType>
					<Default>
						<Value>2</Value>
					</Default>
					<PTCID>#x03002103</PTCID>
				</Parameter>
				<Parameter HideParameter="true" RefreshableValue="true">
					<Name>Ctx_TaskOidMET</Name>
					<Comment><![CDATA[Task implementing ICyclicCaller for cyclic execution of this module]]></Comment>
					<BitSize>32</BitSize>
					<BaseType GUID="{18071995-0000-0000-0000-00000000000F}">OTCID</BaseType>
					<PTCID>#x03002060</PTCID>
				</Parameter>
				<Parameter HideParameter="true" Group="Simulation">
					<Name>Simulation mode</Name>
					<Comment><![CDATA[Specifies if mover is in simulation mode or not, i.e. if the mover needs hardware (driver) connection via CoE.]]></Comment>
					<BitSize>8</BitSize>
					<BaseType GUID="{18071995-0000-0000-0000-000000000030}">BOOL</BaseType>
					<Default>
						<Value>0</Value>
					</Default>
					<PTCID>#x050300b1</PTCID>
					<ContextId OnlineAccess="true">0</ContextId>
				</Parameter>
				<Parameter Group="General">
					<Name>Mover width</Name>
					<Comment><![CDATA[Width that is used for internal collision checks.]]></Comment>
					<BitSize>64</BitSize>
					<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
					<Unit><![CDATA[mm]]></Unit>
					<Default>
						<Value>155.0</Value>
					</Default>
					<PTCID>#x050300b2</PTCID>
					<ContextId OnlineAccess="true">0</ContextId>
				</Parameter>
				<Parameter Group="General">
					<Name>Mover height</Name>
					<Comment><![CDATA[Height that is used for internal collision checks.]]></Comment>
					<BitSize>64</BitSize>
					<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
					<Unit><![CDATA[mm]]></Unit>
					<Default>
						<Value>155.0</Value>
					</Default>
					<PTCID>#x050300b3</PTCID>
					<ContextId OnlineAccess="true">0</ContextId>
				</Parameter>
				<Parameter HideParameter="true" Group="Simulation">
					<Name>Initial position</Name>
					<Comment><![CDATA[Mover position, can be set for disabled mover.]]></Comment>
					<BitSize>384</BitSize>
					<BaseType GUID="{5AC0538E-BDFA-4B58-A6B5-99E997DABADA}" Namespace="MC">MoverVector</BaseType>
					<Unit><![CDATA[mm, °]]></Unit>
					<PTCID>#x050300b5</PTCID>
				</Parameter>
				<Parameter HideParameter="true" Group="General">
					<Name>Minimal position</Name>
					<Comment><![CDATA[Mover minimal position, can be set for disabled mover. For the c coordinate the interpretation is not absolute.]]></Comment>
					<BitSize>384</BitSize>
					<BaseType GUID="{5AC0538E-BDFA-4B58-A6B5-99E997DABADA}" Namespace="MC">MoverVector</BaseType>
					<Unit><![CDATA[mm, °]]></Unit>
					<Default>
						<SubItem>
							<Name>.x</Name>
							<Value>-1e10</Value>
						</SubItem>
						<SubItem>
							<Name>.y</Name>
							<Value>-1e10</Value>
						</SubItem>
						<SubItem>
							<Name>.z</Name>
							<Value>-1.0</Value>
						</SubItem>
						<SubItem>
							<Name>.a</Name>
							<Value>-3.0</Value>
						</SubItem>
						<SubItem>
							<Name>.b</Name>
							<Value>-3.0</Value>
						</SubItem>
						<SubItem>
							<Name>.c</Name>
							<Value>-11.0</Value>
						</SubItem>
					</Default>
					<PTCID>#x050300d3</PTCID>
				</Parameter>
				<Parameter HideParameter="true" Group="General">
					<Name>Maximal position</Name>
					<Comment><![CDATA[Mover maximal position, can be set for disabled mover. For the c coordinate the interpretation is not absolute.]]></Comment>
					<BitSize>384</BitSize>
					<BaseType GUID="{5AC0538E-BDFA-4B58-A6B5-99E997DABADA}" Namespace="MC">MoverVector</BaseType>
					<Unit><![CDATA[mm, °]]></Unit>
					<Default>
						<SubItem>
							<Name>.x</Name>
							<Value>1e10</Value>
						</SubItem>
						<SubItem>
							<Name>.y</Name>
							<Value>1e10</Value>
						</SubItem>
						<SubItem>
							<Name>.z</Name>
							<Value>1.0</Value>
						</SubItem>
						<SubItem>
							<Name>.a</Name>
							<Value>3.0</Value>
						</SubItem>
						<SubItem>
							<Name>.b</Name>
							<Value>3.0</Value>
						</SubItem>
						<SubItem>
							<Name>.c</Name>
							<Value>11.0</Value>
						</SubItem>
					</Default>
					<PTCID>#x050300d4</PTCID>
				</Parameter>
				<Parameter Group="General">
					<Name>C coordinate modulus</Name>
					<Comment><![CDATA[C coordinate modulus, can be set for disabled mover.]]></Comment>
					<BitSize>64</BitSize>
					<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
					<Unit><![CDATA[°]]></Unit>
					<Default>
						<Value>360.0</Value>
					</Default>
					<PTCID>#x05030107</PTCID>
				</Parameter>
				<Parameter Group="General">
					<Name>C coordinate modulo tolerance window</Name>
					<Comment><![CDATA[C coordinate modulo tolerance window, can be set for disabled mover.]]></Comment>
					<BitSize>64</BitSize>
					<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
					<Unit><![CDATA[°]]></Unit>
					<Default>
						<Value>0.0</Value>
					</Default>
					<PTCID>#x05030108</PTCID>
				</Parameter>
				<Parameter HideParameter="true" Group="Simulation">
					<Name>PartOID</Name>
					<Comment><![CDATA[Object id of the PlanarPart the initial position is on.]]></Comment>
					<BitSize>32</BitSize>
					<BaseType GUID="{18071995-0000-0000-0000-00000000000F}">OTCID</BaseType>
					<PTCID>#x050300e0</PTCID>
				</Parameter>
				<Parameter Group="Monitoring">
					<Name>Position Lag Monitoring Enabled</Name>
					<BitSize>8</BitSize>
					<BaseType GUID="{18071995-0000-0000-0000-000000000030}">BOOL</BaseType>
					<Default>
						<Value>1</Value>
					</Default>
					<PTCID>#x0503011a</PTCID>
				</Parameter>
				<Parameter Group="Monitoring">
					<Name>Maximum Position Lag Value</Name>
					<Comment><![CDATA[The maximum of the allowed lag for each coordinate. Must be in [0.0,100.0] for each coordinate.]]></Comment>
					<BitSize>384</BitSize>
					<BaseType GUID="{5AC0538E-BDFA-4B58-A6B5-99E997DABADA}" Namespace="MC">MoverVector</BaseType>
					<Unit><![CDATA[mm, °]]></Unit>
					<Default>
						<SubItem>
							<Name>.x</Name>
							<Value>5.0</Value>
						</SubItem>
						<SubItem>
							<Name>.y</Name>
							<Value>5.0</Value>
						</SubItem>
						<SubItem>
							<Name>.z</Name>
							<Value>1.0</Value>
						</SubItem>
						<SubItem>
							<Name>.a</Name>
							<Value>1.0</Value>
						</SubItem>
						<SubItem>
							<Name>.b</Name>
							<Value>1.0</Value>
						</SubItem>
						<SubItem>
							<Name>.c</Name>
							<Value>1.5</Value>
						</SubItem>
					</Default>
					<PTCID>#x050300be</PTCID>
				</Parameter>
				<Parameter Group="Monitoring">
					<Name>Maximum Position Lag Filter Time</Name>
					<Comment><![CDATA[The maximum of the allowed time for a lag distance violation of each coordinate. Must be in [0.0,10.0] for each coordinate.]]></Comment>
					<BitSize>384</BitSize>
					<BaseType GUID="{5AC0538E-BDFA-4B58-A6B5-99E997DABADA}" Namespace="MC">MoverVector</BaseType>
					<Unit><![CDATA[s]]></Unit>
					<Default>
						<SubItem>
							<Name>.x</Name>
							<Value>0.02</Value>
						</SubItem>
						<SubItem>
							<Name>.y</Name>
							<Value>0.02</Value>
						</SubItem>
						<SubItem>
							<Name>.z</Name>
							<Value>0.02</Value>
						</SubItem>
						<SubItem>
							<Name>.a</Name>
							<Value>0.02</Value>
						</SubItem>
						<SubItem>
							<Name>.b</Name>
							<Value>0.02</Value>
						</SubItem>
						<SubItem>
							<Name>.c</Name>
							<Value>0.02</Value>
						</SubItem>
					</Default>
					<PTCID>#x050300bf</PTCID>
				</Parameter>
				<Parameter Group="Monitoring">
					<Name>Timeout for state machine</Name>
					<Comment><![CDATA[Timout for enable, disable, and reset commands of the user in seconds.]]></Comment>
					<BitSize>64</BitSize>
					<BaseType GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</BaseType>
					<Unit><![CDATA[s]]></Unit>
					<Default>
						<Value>5</Value>
					</Default>
					<PTCID>#x0503d004</PTCID>
				</Parameter>
				<Parameter Group="Maximum Dynamics">
					<Name>Maximum dynamic path XY</Name>
					<Comment><![CDATA[Maximum dynamic of the mover in the XY plane along its path.]]></Comment>
