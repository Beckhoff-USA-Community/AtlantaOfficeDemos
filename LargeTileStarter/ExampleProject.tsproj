				<BitOffs>32</BitOffs>
			</SubItem>
			<SubItem>
				<Name>activePositionIndex</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000005}">UINT</Type>
				<Comment><![CDATA[Index of the current active part position.]]></Comment>
				<BitSize>16</BitSize>
				<BitOffs>48</BitOffs>
			</SubItem>
			<SubItem>
