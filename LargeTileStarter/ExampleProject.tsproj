				<BitOffs>0</BitOffs>
			</SubItem>
			<SubItem>
				<Name>end</Name>
				<Type GUID="{9E820E67-264A-4170-958A-0B26CA5C91FA}" Namespace="MC">MC_POINT_XYC</Type>
				<BitSize>192</BitSize>
