				<Type GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</Type>
				<BitSize>64</BitSize>
				<BitOffs>128</BitOffs>
			</SubItem>
			<Format>
				<Printf>(%g, %g, %g)</Printf>
				<Parameter>.x</Parameter>
				<Parameter>.y</Parameter>
				<Parameter>.c</Parameter>
			</Format>
